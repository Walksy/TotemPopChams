  "name": "Pop Chams",
  "description": "Captures entity states and displays a ghosted version",
  "authors": [
    "Walksy"
  ],
  "contact": {
    "issues": "https://github.com/Walksy/TotemPopChams/issues",
    "sources": "https://github.com/Walksy/TotemPopChams",
    "homepage": "https://discord.com/invite/zeu7uNuBWY"
  },
  "license": "MIT",
  "icon": "assets/walksy/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
